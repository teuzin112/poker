# Postgres (ex.: Neon). Local: rode `npx prisma dev` e use a URL TCP que ele mostrar.
DATABASE_URL="postgresql://user:password@host:5432/poker?sslmode=require"
# Senha para entrar como administrador (quem pode editar)
ADMIN_PASSWORD="troque-esta-senha"
# Segredo para assinar o cookie de sessão — gere com: openssl rand -hex 32
AUTH_SECRET=""
